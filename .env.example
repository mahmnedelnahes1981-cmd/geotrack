# --- Core ---
ENVIRONMENT=development

# Default: SQLite for local dev + tests (no DB server needed).
# Switch to PostgreSQL by setting e.g.:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/geotrack
DATABASE_URL=sqlite:///./geotrack.db

# --- LLM (OpenAI-compatible endpoint; Ollama runs locally by default) ---
# Leave these as-is for local Ollama. To use an external API, change only these three lines.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5vl:7b

# --- Quotes / company identity ---
QUOTE_TAX_RATE=14.0
QUOTE_VALIDITY_DAYS=30
COMPANY_NAME_EN=GeoTrack Foundations & Drilling Co.
COMPANY_NAME_AR=شركة جيوتراك للحفر والأساسات
COMPANY_ADDRESS_EN=(company address)
COMPANY_ADDRESS_AR=(عنوان الشركة)
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_TAX_ID=

# --- Storage ---
UPLOAD_DIR=./storage/uploads
